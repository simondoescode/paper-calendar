#!/usr/bin/env sh
set -eu

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

FILES="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(c|cc|cpp|cxx|h|hh|hpp|hxx|ino)$' || true)"

if [ -z "$FILES" ]; then
  exit 0
fi

if command -v python >/dev/null 2>&1; then
  PYTHON=python
elif command -v python3 >/dev/null 2>&1; then
  PYTHON=python3
elif command -v py >/dev/null 2>&1; then
  PYTHON="py -3"
else
  echo "error: Python is required to run the Paper Calendar pre-commit formatter." >&2
  exit 1
fi

echo "Auto-formatting staged C/C++ files..."
# shellcheck disable=SC2086
$PYTHON scripts/format_changed.py $FILES

# Re-stage formatter changes so the commit contains the formatted content.
# shellcheck disable=SC2086
git add -- $FILES

# Fail if the formatted staged files still do not match the repo rules.
# shellcheck disable=SC2086
$PYTHON scripts/format_changed.py --check $FILES
